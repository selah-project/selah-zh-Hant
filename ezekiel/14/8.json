  "notes": [
    {
      "kind": "idiom",
      "subject": "נתתי פני ב",
      "rationale": "「把我的臉放在某人身上」即敵對他；中文以「變臉」存其意象。"
    },
    {
      "kind": "crux",
      "subject": "והשמתיהו",
      "rationale": "字根「荒涼、驚駭」：欽定本略去，美國標準本作 astonishment；取「使他荒涼」存其字面。"
    },
    {
      "kind": "substitution",
      "subject": "משלים",
      "rationale": "מָשָׁל本義諺語、比喻，此處作警世笑談；「笑談」取其功用義。"
    },
    {
      "kind": "addition",
      "subject": "是",
      "rationale": "「我是雅威」中文需繫動詞，希伯來文無。"
    }
  ],
  "translation": "我必向那人變臉，使他成為記號和笑談，我必從我百姓中間剪除他；你們就知道我是雅威。",
